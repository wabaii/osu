{
  "name": "osu-motion-graphic",
  "private": true,
  "description": "osu!lazer-style motion graphic (1080p60) set to official osu! music",
  "type": "module",
  "scripts": {
    "fetch": "bash scripts/fetch_official.sh",
    "cues": "node scripts/render.mjs cues",
    "audio": "python3 scripts/mix_audio.py build/cues.json build/soundtrack.wav build/spectrum.bin",
    "stills": "node scripts/render.mjs stills",
    "video": "node scripts/render.mjs video",
    "keyframes": "bash scripts/keyframes.sh",
    "build": "npm run fetch && npm run cues && npm run audio && npm run video && npm run keyframes",
    "preview": "node scripts/render.mjs serve"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
